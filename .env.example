# Copy to .env.local and fill in. Never commit real values.

# --- Admin / security (see README) ---
CRON_SECRET=
PAYMENT_WEBHOOK_SECRET=
ADMIN_2FA_ENC_KEY=

# --- Provider: Likeo (https://likeo.net/id) ---
# live = real API calls. mock = fake deterministic data, ONLY when you choose it (tests/experiments).
# Empty or missing = provider not active: nothing is faked, and the admin sees "BELUM DIATUR".
PROVIDER_MODE=live
# Standard SMM panel API v2 endpoint. Check the API page of your Likeo account if this differs.
LIKEO_API_URL=https://likeo.net/api/v2
# Your API key from the Likeo account page. Server-side only: never prefix with NEXT_PUBLIC_.
LIKEO_API_KEY=

# --- Supabase ---
# Local: run `npm run db:start`, then copy the URL / anon key / service_role key it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte key (base64) that encrypts provider API keys at rest.
PROVIDER_KEY_ENC_KEY=
