# Copy to .env.local and fill in. Never commit real values.

# --- Admin / security (see docs/supabase-setup.md) ---
CRON_SECRET=

# --- Payment gateway: Paymenku (https://paymenku.com), top-ups on Tambah Saldo ---
# PAYMENKU_API_KEY: sk_test_... (sandbox) works ONLY on the DEV project (a sandbox payment moves no money). sk_live_... needs approved KYC and works ONLY when
#   PAYMENT_LIVE_APPROVED_REF equals the project ref of NEXT_PUBLIC_SUPABASE_URL (never on the DEV project). Anything else: the gateway is off.
# PAYMENKU_WEBHOOK_SECRET: the webhook secret of the same Paymenku merchant (Dashboard > Webhook). Webhook URL to register there: {NEXT_PUBLIC_SITE_URL}/api/webhooks/paymenku
# "Teruskan biaya ke pelanggan" (fee pass-through) is an ADMIN setting (Admin > Pengaturan > Pembayaran > Paymenku, default off): no environment variable.
# PAYMENKU_API_BASE exists for the tests only (a local fake gateway): leave it empty. The old PAYMENT_WEBHOOK_SECRET is gone: there is ONE name, PAYMENKU_WEBHOOK_SECRET.
PAYMENKU_API_KEY=
PAYMENKU_WEBHOOK_SECRET=
PAYMENT_LIVE_APPROVED_REF=
PAYMENKU_API_BASE=

# --- Provider: Likeo (https://likeo.net/id) ---
# The real provider (and real spending) is reachable ONLY from a Supabase project you approve explicitly:
#   PROVIDER_LIVE_APPROVED_REF = the ref of the project in NEXT_PUBLIC_SUPABASE_URL, AND PROVIDER_MODE=live.
# Anywhere else the app uses MOCK data (dev, tests, local); a production build against an unapproved project is OFF (nothing faked, nothing spent).
# For real Likeo calls from the DEV project, set PROVIDER_LIVE_APPROVED_REF to the dev ref on purpose. On the production host set it to the production ref.
#   PROVIDER_CUSTOM_COMMENTS=1 enables Custom Comments orders against the REAL provider. Verified for Likeo on 2026-11-06 (one real order); may be set in production together with PROVIDER_MODE=live and PROVIDER_LIVE_APPROVED_REF. The mock always accepts them.
PROVIDER_MODE=mock
PROVIDER_LIVE_APPROVED_REF=
# Standard SMM panel API v2 endpoint. Check the API page of your Likeo account if this differs.
LIKEO_API_URL=https://likeo.net/api/v2
# Your API key from the Likeo account page. Server-side only: never prefix with NEXT_PUBLIC_.
LIKEO_API_KEY=

# --- Supabase ---
# Local: run `npm run db:start`, then copy the URL / anon key / service_role key it prints.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (new) or anon (legacy) key: either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Ref of the linked DEV project; db scripts refuse to run against any other project.
SUPABASE_DEV_PROJECT_REF=
# 32-byte key (base64) that encrypts provider API keys at rest.
PROVIDER_KEY_ENC_KEY=

# --- Site / auth ---
# Public origin used in e-mail links and OAuth redirects (leave empty in dev to use the request origin).
NEXT_PUBLIC_SITE_URL=

# --- Scheduling (see docs/supabase-setup.md) ---
# Local `npm run dev:cron` loop: CRON_INTERVAL_SECONDS (default 120) and CRON_BASE_URL (default http://localhost:3000).
CRON_INTERVAL_SECONDS=
CRON_BASE_URL=
